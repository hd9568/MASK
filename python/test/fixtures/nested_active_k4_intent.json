          "length": "M",
          "reorder": null,
          "purpose": "按BLK_M=16切分外层行窗口"
        },
        {
          "name": "Y_s",
          "type": "sv",
          "direction": "COL",
          "length": "K",
          "reorder": null,
          "purpose": "每个行窗口实际出现的去重列，真实长度由窗口元数据给出"
