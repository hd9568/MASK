          "purpose": "将凝聚列按BLK_K=8切分的外层块序号"
        },
        {
          "name": "Y_si",
          "type": "df",
          "direction": "COL",
          "length": "BLK_K",
          "reorder": null,
          "purpose": "外层16x8 TC块内8列"
        },
        {
          "name": "X_i",
          "type": "df",
          "direction": "ROW",
          "length": "BLK_M",
          "reorder": null,
          "purpose": "外层TC块内16行，复用L1行坐标"
