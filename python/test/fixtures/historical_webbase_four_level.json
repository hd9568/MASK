{
  "format_name": "TCF_16x8_ACTIVE_K4_DENSE",
  "levels": [
    {
      "level": 1,
      "name": "row_window_condensation",
      "axes": [
        {
          "name": "X_o",
          "type": "df",
          "direction": "ROW",
          "length": "M",
          "reorder": null,
          "purpose": "按BLK_M=16切分外层行窗口"
        },
        {
          "name": "Y_s",
          "type": "sv",
          "direction": "COL",
          "length": "K",
          "reorder": null,
          "purpose": "每个行窗口实际出现的去重列，真实长度由窗口元数据给出"
        },
        {
          "name": "X_i",
          "type": "df",
          "direction": "ROW",
          "length": "BLK_M",
          "reorder": null,
          "purpose": "窗口内固定16行坐标"
        }
      ]
    },
    {
      "level": 2,
      "name": "outer_tc_block",
      "axes": [
        {
          "name": "Y_so",
          "type": "df",
          "direction": "COL",
          "length": "K/BLK_K",
          "reorder": null,
          "purpose": "将凝聚列按BLK_K=8切分的外层块序号"
        },
        {
          "name": "Y_si",
          "type": "df",
          "direction": "COL",
          "length": "BLK_K",
          "reorder": null,
          "purpose": "外层16x8 TC块内8列"
        },
        {
          "name": "X_i",
          "type": "df",
          "direction": "ROW",
          "length": "BLK_M",
          "reorder": null,
          "purpose": "外层TC块内16行，复用L1行坐标"
        }
      ]
    },
    {
      "level": 3,
      "name": "inner_column_sparsification",
      "axes": [
        {
          "name": "Y_sis",
          "type": "sv",
          "direction": "COL",
          "length": "BLK_K",
          "reorder": null,
          "purpose": "每个16x8块内实际活跃的4列子块选择；真实活跃子块数由父块元数据给出"
        },
        {
          "name": "X_i",
          "type": "df",
          "direction": "ROW",
          "length": "BLK_M",
          "reorder": null,
          "purpose": "保持16行物理TC行组"
        }
      ]
    },
    {
      "level": 4,
      "name": "inner_tc_block",
      "axes": [
        {
          "name": "Y_siso",
          "type": "df",
          "direction": "COL",
          "length": "BLK_K/BLK_K_I",
          "reorder": null,
          "purpose": "4列活跃子块在8列外层块内的序号"
        },
        {
          "name": "Y_sisi",
          "type": "df",
          "direction": "COL",
          "length": "BLK_K_I",
          "reorder": null,
          "purpose": "4列活跃子块内部列坐标"
        },
        {
          "name": "X_i",
          "type": "df",
          "direction": "ROW",
          "length": "BLK_M",
          "reorder": null,
          "purpose": "16行物理TC行组，构成16x4 dense leaf"
        }
      ]
    }
  ],
  "atomic": {
    "type": "dense",
    "x_axis": "X_i",
    "y_axis": "Y_sisi",
    "layout": "row_major",
    "rationale": "活跃16x4子块已在L3选出，leaf无需位掩码/坐标；dense staging 64个A值可降低恢复元数据。",
    "custom_spec": null
  },
  "params": {
    "BLK_M": 16,
    "BLK_K": 8,
    "BLK_K_I": 4
  }
}
